<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>AutoWorldStart</AssemblyName>
    <RootNamespace>Hunter9732ru.AutoWorldStart</RootNamespace>
    <Version>1.0.3</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Optimize>true</Optimize>
    <ValheimPath Condition="'$(ValheimPath)' == ''">$(VALHEIM_PATH)</ValheimPath>
    <ManagedPath Condition="'$(ManagedPath)' == ''">$(ValheimPath)/valheim_Data/Managed</ManagedPath>
    <BepInExPath Condition="'$(BepInExPath)' == ''">$(ValheimPath)/BepInEx</BepInExPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="$(ManagedPath)/*.dll"
               Exclude="$(ManagedPath)/mscorlib.dll;$(ManagedPath)/netstandard.dll;$(ManagedPath)/System*.dll;$(ManagedPath)/Mono.Security.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExPath)/core/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExPath)/core/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckLocalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ManagedPath)/Assembly-CSharp.dll')" Text="Set ValheimPath or ManagedPath to a local Valheim installation." />
    <Error Condition="!Exists('$(BepInExPath)/core/BepInEx.dll')" Text="Set BepInExPath to the BepInEx folder in your game or mod-manager profile." />
    <Error Condition="!Exists('$(BepInExPath)/core/0Harmony.dll')" Text="0Harmony.dll is missing from BepInEx/core." />
  </Target>
</Project>
